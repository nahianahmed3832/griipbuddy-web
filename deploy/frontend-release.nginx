# Include inside the frontend.griipbuddy.com TLS server.
location = /release { return 308 https://frontend.griipbuddy.com/$is_args$args; }
location ~ ^/release(/.*)$ { return 308 https://frontend.griipbuddy.com$1$is_args$args; }
location ~ ^/(?:bd|international)/?$ { return 302 https://frontend.griipbuddy.com/$is_args$args; }

location / {
    client_max_body_size 5m;
    proxy_http_version 1.1;
    proxy_set_header Host frontend.griipbuddy.com;
    proxy_set_header X-Forwarded-Host frontend.griipbuddy.com;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization "";
    proxy_read_timeout 45s;
    proxy_buffering off;
    add_header X-Content-Type-Options nosniff always;
    proxy_pass http://127.0.0.1:4398;
}
