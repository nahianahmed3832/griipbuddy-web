COMMERCE_MODE=staging
DATABASE_URL=postgresql://griipbuddy_stage:replace-me@db:5432/griipbuddy_staging
BETTER_AUTH_URL=https://staging.example.test
BETTER_AUTH_SECRET=
CHECKOUT_SECRET=
STAGING_USER=reviewer
STAGING_PASSWORD=
# Shopper email is disabled until configured. The isolated hybrid dev host uses preview.
# Preview captures messages for @example.invalid in the owner-only test email inbox.
# Other marketplace environments can use authenticated SMTP with TLS.
# SHOPPER_MAIL_MODE=smtp
# SHOPPER_MAIL_FROM=contact@griipbuddy.com
# SHOPPER_SMTP_URL=smtps://username:password@mail.example.test:465
# Optional registered origins for distinct storefronts sharing the shopper identity database.
# SHOPPER_IDENTITY_ORIGIN=https://identity.example.test
# SHOPPER_BD_ORIGIN=https://bd.example.test
# SHOPPER_US_ORIGIN=https://us.example.test
# Optional only on an isolated hybrid account fixture. Checkout stays closed for this market.
# GRIIP_FIXTURE_MARKET=ca
# Set this only behind an ingress that overwrites the named header.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
