  OUT_FOR_DELIVERY
  DELIVERED
  REFUSED
  RETURNED
}

enum ParcelTrackingStatus {
  PREPARING
  HANDED_TO_CARRIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_EXCEPTION
  RETURNED
}

