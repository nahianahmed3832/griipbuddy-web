model OrderParcel {
  id                String                      @id @default(uuid()) @db.Uuid
  orderId           String                      @db.Uuid
  order             Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  locationId        String
  location          DispatchLocation            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationName      String                      @db.VarChar(120)
  status            OrderParcelStatus           @default(PLANNED)
  carrier           String?                     @db.VarChar(60)
  trackingReference String?                     @db.VarChar(80)
  source            BangladeshShipmentSource?
  statusUpdatedAt   DateTime                    @default(now())
  receivedAt        DateTime?
  returnDisposition BangladeshReturnDisposition?
