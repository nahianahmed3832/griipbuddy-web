generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MarketCode {
  bd
  us
}

enum CurrencyCode {
  BDT
  USD
}

enum CollectionSelection {
  CURATED
  NEW
  FEATURED
}

enum PublicationState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CatalogMigrationStatus {
  RUNNING
  PAUSED
  FAILED
  COMPLETED
}

enum DepartmentKind {
  DEPARTMENT
  CATEGORY
  SUBCATEGORY
}

enum CatalogAttributeScope {
  PRODUCT
  VARIANT
}

enum CatalogAttributeType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

enum MenuPage {
  HOME
  SEARCH
  SHOP
}

enum TaxTreatment {
  MERCHANDISE_RATE
}

enum CommerceEvidence {
  fixture
  sandbox
  production
}

enum OrderStatus {
  PLACED
  CANCELLED
}

enum PaymentMethod {
  COD
  PAYPAL
  SSLCOMMERZ
}

enum InventoryReservationState {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
  CANCELLED
  PAYMENT_EXCEPTION
}

enum InventoryMovementKind {
  RECEIPT
  DISPATCH
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum PaymentStatus {
  AWAITING_COLLECTION
  COLLECTED
  VOIDED
  PAID
  REFUND_PENDING
  REFUNDED
}

enum CodRemittanceStatus {
  DISCREPANCY
  MATCHED
}

enum PayPalCheckoutState {
  CREATING
  APPROVAL
  CAPTURING
  COMPLETED
  CANCELLED
}

enum PrepaidCheckoutState {
  PREPARING
  AWAITING_PAYMENT
  PAID
  CLOSED
}

enum FulfillmentStatus {
  UNFULFILLED
  PACKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum SellerPreparationStatus {
  PREPARING
  READY
  HANDED_OFF
}

enum FulfillmentEventType {
  ORDER_PLACED
  STATUS_CHANGED
  ORDER_CANCELLED
}

enum StaffRole {
  OWNER
  PACKER
}

enum AuditAction {
  STAFF_CREATED
  STAFF_REVOKED
  FULFILLMENT_CHANGED
  ORDER_CANCELLED
  CASH_COLLECTION_RECORDED
  STOCK_CHANGED
  PRICE_CHANGED
  PRODUCT_SAVED
  TAXONOMY_SAVED
  MARKET_SETTINGS_CHANGED
  MERCHANDISING_REVIEW
  COUPON_CHANGED
  MARKETPLACE_GRANT_CHANGED
  BD_REFUSED_PARCEL_RECEIVED
  BD_RETURN_CASE_RECEIVED
  BD_CASE_PICKUP_SCHEDULED
  BD_CASE_CANCELLATION_APPROVED
  BD_CASE_REFUND_APPROVED
  BD_EXCHANGE_SHIPPED
}

model Department {
  id          String    @id
  slug        String    @unique
  name        String
  shortName   String
  description String
  imageSrc    String
  imageAlt    String
  bannerSrc   String?  @db.VarChar(100)
  bannerAlt   String?  @db.VarChar(180)
  seoTitle    String?  @db.VarChar(120)
  seoDescription String? @db.VarChar(320)
  position    Int
  parentId    String?
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Department[] @relation("DepartmentTree")
  products    Product[]
  kind        DepartmentKind?
  state       PublicationState @default(ACTIVE)
  revision    Int @default(0)
  secondaryProducts ProductSecondaryCategory[]
  translations DepartmentTranslation[]
  slugAliases DepartmentSlugAlias[]
  marketPresentations DepartmentMarketPresentation[]
  attributeTemplates CategoryAttributeTemplate[]
  menuItems MarketMenuItem[]

  @@index([parentId, position])
  @@index([parentId, position, id])
}

model DepartmentTranslation {
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  locale       String     @db.VarChar(35)
  name         String
  shortName    String
  description  String
  slug         String?    @db.VarChar(120)

  @@id([departmentId, locale])
  @@unique([locale, slug])
  @@index([slug])
}

model DepartmentSlugAlias {
  locale       String     @db.VarChar(35)
  slug         String     @db.VarChar(120)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([locale, slug])
  @@index([slug])
  @@index([departmentId])
}

model DepartmentMarketPresentation {
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  marketId            MarketCode
  visibleInNavigation Boolean?
  position            Int?
  imageSrc            String?
  imageAlt            String?

  @@id([departmentId, marketId])
  @@index([marketId, visibleInNavigation, position])
}

model CatalogAttributeDefinition {
  id               String @id
  name             String
  scope            CatalogAttributeScope
  dataType         CatalogAttributeType
  allowedValues    String[] @default([])
  variantOptionKey String? @unique
  templates        CategoryAttributeTemplate[]
}

model CategoryAttributeTemplate {
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  attributeId  String
  attribute    CatalogAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  required     Boolean @default(false)
  filterable   Boolean @default(false)
  position     Int @default(0)
  inheritable  Boolean @default(true)
  excluded     Boolean @default(false)

  @@id([departmentId, attributeId])
  @@index([attributeId])
}

model Product {
  id             String              @id
  slug           String              @unique
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id])
  name           String
  brand          String?             @db.VarChar(70)
  description    String
  shortDescription String?
  specifications Json
  keywords       String[]
  addedOn        DateTime            @db.Date
  position       Int
  newArrival     Boolean             @default(false)
  featured       Boolean             @default(false)
  active         Boolean             @default(true)
  publication    PublicationState    @default(DRAFT)
  demo           Boolean             @default(false)
  revision       Int                 @default(0)
  personalizationPrompt String? @db.VarChar(180)
  personalizationRequired Boolean @default(false)
  images         ProductImage[]
  variants       Variant[]
  collections    CollectionProduct[]
  marketplaceShopId String? @db.Uuid
  marketplaceShop MarketplaceShop? @relation(fields: [marketplaceShopId], references: [id], onDelete: Restrict)
  favorites ShopperFavorite[]
  savedIn ShopperListItem[]
  reviews ShopperReview[]
  secondaryCategories ProductSecondaryCategory[]
  foundation     Boolean             @default(false)
  attributeValues Json?
  translations ProductTranslation[]
  optionDefinitions ProductOption[]
  migrationRedirects CatalogMigrationRedirect[] @relation("ProductMigrationTarget")
  migratedFromSlug CatalogMigrationRedirect? @relation("ProductMigrationSource")

  @@unique([id, departmentId])
  @@index([departmentId])
  @@index([publication, position])
  @@index([marketplaceShopId, publication])
}

model CatalogMigrationRun {
  id              String                 @id @db.Char(64)
  version         String
  status          CatalogMigrationStatus @default(RUNNING)
  expectedBatches Int
  failureCode     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  checkpoints     CatalogMigrationCheckpoint[]
  mappings        CatalogMigrationMapping[]
}

model CatalogMigrationCheckpoint {
  runId        String              @db.Char(64)
  run          CatalogMigrationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  batchKey     String
  sourceDigest String              @db.Char(64)
  targetDigest String              @db.Char(64)
  report       Json
  completedAt  DateTime            @default(now())

  @@id([runId, batchKey])
}

model CatalogMigrationMapping {
  sourceSystem String
  entity       String
  sourceId     String
  targetId     String
  runId        String              @db.Char(64)
  run          CatalogMigrationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())

  @@id([sourceSystem, entity, sourceId])
  @@index([entity, targetId])
  @@index([runId])
}

model CatalogMigrationRedirect {
  slug            String  @id
  productId       String
  product         Product @relation("ProductMigrationTarget", fields: [productId], references: [id], onDelete: Restrict)
  sourceProductId String  @unique
  sourceProduct   Product @relation("ProductMigrationSource", fields: [sourceProductId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model ProductTranslation {
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           String  @db.VarChar(35)
  name             String
  description      String
  shortDescription String?

  @@id([productId, locale])
}

model ProductOption {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  id        String
  key       String  @db.VarChar(40)
  label     String
  position  Int
  values    ProductOptionValue[]

  @@id([productId, id])
  @@unique([productId, key])
  @@index([productId, position, id])
}

model ProductOptionValue {
  productId  String
  optionId   String
  option     ProductOption @relation(fields: [productId, optionId], references: [productId, id], onDelete: Cascade)
  id         String
  value      String
  label      String
  position   Int
  selections VariantOptionSelection[]

  @@id([productId, optionId, id])
  @@unique([productId, optionId, value])
  @@index([productId, optionId, position, id])
}

model ProductSecondaryCategory {
  productId           String
  primaryDepartmentId String
  product             Product @relation(fields: [productId, primaryDepartmentId], references: [id, departmentId], onDelete: Cascade, onUpdate: Cascade)
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([productId, departmentId])
  @@index([departmentId, productId])
}

model CatalogMedia {
  id        String   @id @db.Char(64)
  data      Bytes
  editorial Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MerchandisingCandidate {
  id              String   @id @db.Char(64)
  productId       String
  source          Json
  sourceVersion   String   @db.Char(64)
  draft           Json
  baseline        Json?
  baseRevision    Int?
  revision        Int      @default(1)
  decision        String   @default("pending")
  approval        Json?
  ownsDraft       Boolean  @default(false)
  catalogRevision Int?
  stagedRevision  Int?
  publishedAt     DateTime?
  launch          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
  @@index([productId, ownsDraft])
}

model ProductImage {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  src       String
  alt       String
  isPrimary Boolean @default(false)

  @@id([productId, position])
  @@index([src])
}

model Variant {
  id        String        @id
  sku       String        @unique
  gtin      String?       @db.VarChar(14)
  mpn       String?       @db.VarChar(70)
  identifiersNotAssigned Boolean @default(false)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  options   Json
  label     String
  imageSrc  String?
  imageAlt  String?
  position  Int
  active    Boolean       @default(true)
  inventory Inventory?
  locationInventory LocationInventory[]
  offers    MarketOffer[]
  purchases OrderItem[]
  exchangeReplacements OrderCaseReturnLine[] @relation("ExchangeReplacement")
  shopperWatches ShopperVariantWatch[]
  optionSignature String?
  isDefault Boolean @default(false)
  archivedAt DateTime?
  attributeValues Json?
  optionSelections VariantOptionSelection[]
  compatibility VariantCompatibility[]
  images VariantImage[]
  managedInventory Boolean @default(false)
  inventoryPools InventoryPool[]
  offerIdentities MarketOfferIdentity[]

  @@unique([id, productId])
  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([imageSrc])
}

model VariantOptionSelection {
  variantId     String
  productId     String
  optionId      String
  optionValueId String
  variant       Variant            @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [productId, optionId, optionValueId], references: [productId, optionId, id], onDelete: Restrict)

  @@id([variantId, optionId])
  @@index([productId, optionId, optionValueId, variantId])
}

model VariantImage {
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  position  Int
  src       String
  alt       String
  isPrimary Boolean @default(false)

  @@id([variantId, position])
  @@unique([variantId, src])
  @@index([src])
}

model DeviceModel {
  id            String @id
  brand         String
  name          String
  lookupKey     String @unique
  revision      Int    @default(0)
  aliases       DeviceModelAlias[]
  compatibility VariantCompatibility[]
}

model DeviceModelAlias {
  lookupKey String @id
  modelId   String
  model     DeviceModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  label     String

  @@index([modelId])
}

model VariantCompatibility {
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  modelId   String
  model     DeviceModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@id([variantId, modelId])
  @@index([modelId, variantId])
}

model Collection {
  id          String              @id
  slug        String              @unique
  name        String
  description String
  selection   CollectionSelection @default(CURATED)
  position    Int
  imageSrc    String?
  imageAlt    String?
  revision    Int                 @default(0)
  defaultPublished Boolean        @default(true)
  products    CollectionProduct[]
  menuItems   MarketMenuItem[]
  marketPublications CollectionMarketPublication[]
}

model CollectionMarketPublication {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  marketId     MarketCode
  published    Boolean

  @@id([collectionId, marketId])
  @@index([marketId, published])
}

model MarketMenu {
  id        String     @id @default(cuid())
  marketId  MarketCode
  key       String
  locale    String     @default("") @db.VarChar(35)
  revision  Int        @default(0)
  items     MarketMenuItem[]

  @@unique([marketId, key, locale])
}

model MarketMenuItem {
  menuId       String
  menu         MarketMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  position     Int
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  page         MenuPage?
  label        String? @db.VarChar(80)
  visible      Boolean @default(true)

  @@id([menuId, position])
  @@index([departmentId])
  @@index([collectionId])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int?

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
}

model MarketOffer {
  variantId          String
  variant            Variant      @relation(fields: [variantId], references: [id])
  marketId           MarketCode
  currency           CurrencyCode
  amountMinor        Int
  eligible           Boolean      @default(true)
  discountMinor      Int?
  discountStartsAt   DateTime?
  discountEndsAt     DateTime?
  offerId            String?      @unique @db.Uuid
  identity           MarketOfferIdentity? @relation(fields: [offerId, variantId, marketId], references: [id, variantId, marketId], onDelete: Restrict)
  publication        PublicationState @default(ACTIVE)
  revision           Int          @default(0)

  @@id([variantId, marketId])
  @@unique([offerId, variantId, marketId])
  @@index([marketId, eligible])
}

model MarketOfferIdentity {
  id           String          @id @default(uuid()) @db.Uuid
  variantId    String
  variant      Variant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  marketId     MarketCode
  sellerId     String          @db.Uuid
  seller       MarketplaceShop @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  retiredAt    DateTime?
  retiredTerms Json?
  current      MarketOffer?
  allocations  InventoryAllocation[]

  @@unique([id, variantId, marketId])
  @@index([variantId, marketId])
  @@index([sellerId, marketId])
}

// Shared dispatch stock for variants that have not moved to location inventory.
model Inventory {
  variantId String   @id
  variant   Variant  @relation(fields: [variantId], references: [id])
  available Int
  updatedAt DateTime @updatedAt
}

model DispatchLocation {
  id        String              @id @default(cuid())
  name      String              @db.VarChar(120)
  marketId  MarketCode?
  shopId    String?             @db.Uuid
  shop      MarketplaceShop?    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  active    Boolean             @default(true)
  priority  Int                 @default(100)
  inventory LocationInventory[]
  parcels   OrderParcel[]
  marketServices DispatchLocationMarket[]
  pools InventoryPool[]

  @@index([marketId, active, priority])
  @@index([shopId])
}

model LocationInventory {
  variantId  String
  variant    Variant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId String
  location   DispatchLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  available  Int
  updatedAt  DateTime         @updatedAt

  @@id([variantId, locationId])
  @@index([locationId])
}

model DispatchLocationMarket {
  locationId String
  location   DispatchLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  marketId   MarketCode
  active     Boolean          @default(true)
  priority   Int              @default(100)
  districts  String[]         @default([])
  methods    String[]         @default([])

  @@id([locationId, marketId])
  @@index([marketId, active, priority])
}

model InventoryPool {
  id          String           @id @default(uuid()) @db.Uuid
  variantId   String
  variant     Variant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  ownerId     String           @db.Uuid
  owner       MarketplaceShop  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  locationId  String
  location    DispatchLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  onHand      Int              @default(0)
  reserved    Int              @default(0)
  updatedAt   DateTime         @updatedAt
  allocations InventoryAllocation[]
  movements   InventoryMovement[] @relation("InventoryMovementPool")
  relatedMovements InventoryMovement[] @relation("InventoryMovementRelatedPool")

  @@unique([variantId, ownerId, locationId])
  @@index([ownerId, locationId])
  @@index([locationId])
}

model InventoryReservation {
  id               String                    @id @default(uuid()) @db.Uuid
  attemptId        String                    @unique @db.Uuid
  attempt          CheckoutAttempt           @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  marketId         MarketCode
  paymentMethod    PaymentMethod
  state            InventoryReservationState @default(HELD)
  requestHash      String                    @db.Char(64)
  expiresAt        DateTime
  orderId          String?                   @unique @db.Uuid
  order            Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentReference String?
  paymentAmountMinor Int?
  paymentCurrency    CurrencyCode?
  exceptionReason  String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  allocations      InventoryAllocation[]

  @@unique([paymentMethod, paymentReference])
  @@index([state, expiresAt])
  @@index([marketId, state])
}

model InventoryAllocation {
  id            String               @id @default(uuid()) @db.Uuid
  reservationId String               @db.Uuid
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  offerId       String               @db.Uuid
  offer         MarketOfferIdentity  @relation(fields: [offerId], references: [id], onDelete: Restrict)
  poolId        String               @db.Uuid
  pool          InventoryPool        @relation(fields: [poolId], references: [id], onDelete: Restrict)
  quantity      Int
  amountMinor   Int
  currency      CurrencyCode
  offerRevision Int
  dispatched    Int                  @default(0)
  returned      Int                  @default(0)
  movements     InventoryMovement[]

  @@unique([reservationId, offerId, poolId])
  @@unique([id, poolId])
  @@index([offerId])
  @@index([poolId])
}

model InventoryMovement {
  id             String             @id @default(uuid()) @db.Uuid
  poolId         String             @db.Uuid
  pool           InventoryPool      @relation("InventoryMovementPool", fields: [poolId], references: [id], onDelete: Restrict)
  relatedPoolId  String?            @db.Uuid
  relatedPool    InventoryPool?     @relation("InventoryMovementRelatedPool", fields: [relatedPoolId], references: [id], onDelete: Restrict)
  allocationId   String?            @db.Uuid
  allocation     InventoryAllocation? @relation(fields: [allocationId, poolId], references: [id, poolId], onDelete: Restrict)
  idempotencyKey String
  kind           InventoryMovementKind
  quantity       Int
  reason         String
  reference      String
  actorId        String?
  createdAt      DateTime           @default(now())

  @@unique([poolId, idempotencyKey])
  @@index([poolId, createdAt])
  @@index([allocationId])
  @@index([relatedPoolId])
  @@index([kind, reference])
}

model CheckoutPolicy {
  marketId       MarketCode   @id
  countryCode    String       @db.Char(2)
  currency       CurrencyCode
  enabled        Boolean      @default(false)
  codEnabled     Boolean      @default(false)
  revision       Int          @default(0)
  taxTreatment   TaxTreatment?
  taxBasisPoints Int?
  taxLabel       String?
  deliveryZones  DeliveryZone[]
}

model DeliveryZone {
  marketId      MarketCode
  policy        CheckoutPolicy @relation(fields: [marketId], references: [marketId])
  district      String
  districtLabel String
  method        String
  label         String
  chargeMinor   Int?
  guidance      String?
  codEligible   Boolean        @default(true)
  revision      Int            @default(0)
  enabled       Boolean        @default(true)

  @@id([marketId, district, method])
}

model CheckoutAttempt {
  id          String   @id @db.Uuid
  guestKey    String   @db.VarChar(64)
  requestHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())
  abandonedAt DateTime?
  recoveredCart Json?
  marketId    MarketCode?
  paymentMethod PaymentMethod?
  commerceEvidence CommerceEvidence?
  commercialSnapshot Json?
  order       Order?
  paypal      PayPalCheckout?
  prepaid     PrepaidCheckout?
  measurement MeasurementAttempt?
  inventoryReservation InventoryReservation?

  @@index([marketId, commerceEvidence])
}

model PayPalCheckout {
  attemptId       String              @id @db.Uuid
  attempt         CheckoutAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  state           PayPalCheckoutState @default(CREATING)
  checkout        Json?
  quote           Json?
  stockAllocations Json?
  shopperId       String?
  providerOrderId String?             @unique
  approvalUrl     String?
  captureId       String?             @unique
  captureStartedAt DateTime?
  refundId        String?             @unique
  refundStartedAt DateTime?
  refundActorId   String?
  providerFailedAt DateTime?
  providerFailureCode String? @db.VarChar(24)
  expiresAt       DateTime

  @@index([state, expiresAt])
  @@index([providerFailedAt])
}

model PrepaidCheckout {
  attemptId           String               @id @db.Uuid
  attempt             CheckoutAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  providerId          String               @unique @db.VarChar(30)
  state               PrepaidCheckoutState @default(PREPARING)
  checkout            Json?
  quote               Json?
  stockAllocations    Json?
  marketplaceShopIds  Json?
  shopperId           String?
  direct              Boolean              @default(false)
  couponCode          String?              @db.VarChar(32)
  redirectUrl         String?
  bankTransactionId   String?              @unique
  providerFailedAt    DateTime?
  providerFailureCode String?              @db.VarChar(24)
  expiresAt           DateTime

  @@index([state, expiresAt])
  @@index([couponCode, state])
  @@index([providerFailedAt])
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  reference         String            @unique
  attemptId         String            @unique @db.Uuid
  attempt           CheckoutAttempt   @relation(fields: [attemptId], references: [id])
  marketId          MarketCode
  currency          CurrencyCode
  status            OrderStatus       @default(PLACED)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  customerName      String
  phone             String
  email             String?
  district          String
  districtLabel     String
  locality          String
  address           String
  postalCode        String?
  deliveryMethod    String
