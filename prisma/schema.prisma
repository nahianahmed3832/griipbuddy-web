  shopper    Shopper                @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  items      Json                   @default("[]")
  saved      Json                   @default("[]")
  revision   Int                    @default(0)
  updatedAt  DateTime               @updatedAt
  operations ShopperCartOperation[]
}

model ShopperCartOperation {
  shopperId   String
  cart        ShopperCart @relation(fields: [shopperId], references: [shopperId], onDelete: Cascade)
  operationId String      @db.Uuid
  createdAt   DateTime    @default(now())

  @@id([shopperId, operationId])
}

enum VariantWatchEventKind {
  BACK_IN_STOCK
  PRICE_DROP
}

model ShopperVariantWatch {
  id             String                     @id @default(uuid()) @db.Uuid
  shopperId      String
  shopper        Shopper                    @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant                    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  marketId       MarketCode
  backInStock    Boolean                    @default(false)
  priceDrop      Boolean                    @default(false)
  lastAvailable  Boolean?
  lastPriceMinor Int?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  events         ShopperVariantWatchEvent[]

  @@unique([shopperId, variantId, marketId])
}

model ShopperVariantWatchEvent {
  id                  String                @id @default(uuid()) @db.Uuid
  watchId             String                @db.Uuid
  watch               ShopperVariantWatch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  kind                VariantWatchEventKind
  amountMinor         Int?
  previousAmountMinor Int?
  createdAt           DateTime              @default(now())

  @@index([watchId, createdAt])
}

model ShopperSession {
  id String @id
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user Shopper @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShopperIdentity {
  id String @id
  accountId String
  providerId String
  userId String
  user Shopper @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model ShopperVerification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model MarketplaceCoupon {
  code         String @id @db.VarChar(32)
  marketId     MarketCode @default(bd)
  shopId       String? @db.Uuid
  shop         MarketplaceShop? @relation(fields: [shopId], references: [id], onDelete: Restrict)
  kind         String
  value        Int
  minimumMinor Int @default(0)
  useLimit     Int?
  enabled      Boolean @default(true)
  endsAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([shopId])
  @@index([marketId, createdAt])
}

model MarketplaceShop {
  id String @id @default(uuid()) @db.Uuid
  ownerId String? @unique
  owner Shopper? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  slug String @unique
  name String
  announcement String
  about String
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listings Product[]
  followers ShopperFollow[]
  coupons MarketplaceCoupon[]
  requests ShopperRequest[]
  fulfillments MarketplaceSellerFulfillment[]
  marketGrants MarketplaceShopMarket[]
  dispatchLocations DispatchLocation[]
  offerIdentities MarketOfferIdentity[]
  inventoryPools InventoryPool[]
}

enum MarketplaceMarketStatus {
  PENDING
  APPROVED
  DENIED
}

model MarketplaceShopMarket {
  shopId String @db.Uuid
  shop MarketplaceShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  marketId MarketCode
  status MarketplaceMarketStatus @default(PENDING)
  requestedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([shopId, marketId])
  @@index([marketId, status])
}

model MarketplaceSellerFulfillment {
  orderId   String                  @db.Uuid
  order     Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopId    String                  @db.Uuid
  shop      MarketplaceShop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  status    SellerPreparationStatus
  updatedAt DateTime                @updatedAt

  @@id([orderId, shopId])
  @@index([shopId])
}

model ShopperFavorite {
  shopperId String
  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([shopperId, productId])
  @@index([shopperId, createdAt])
}

model ShopperList {
  id String @id @default(uuid()) @db.Uuid
  shopperId String
  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  name String
  registry Boolean @default(false)
  public Boolean @default(false)
  createdAt DateTime @default(now())
  items ShopperListItem[]

  @@index([shopperId, createdAt])
}

model ShopperListItem {
  listId String @db.Uuid
  list ShopperList @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([listId, productId])
  @@index([listId, createdAt])
}

model ShopperFollow {
  shopperId String
  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  shopId String @db.Uuid
  shop MarketplaceShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([shopperId, shopId])
}

model ShopperReview {
  id String @id @default(uuid()) @db.Uuid
  shopperId String
  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  stars Int
  text String
  visible Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId, visible, createdAt])
}

model ShopperRequest {
  id String @id @default(uuid()) @db.Uuid
  shopperId String
  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Restrict)
  shopId String @db.Uuid
  shop MarketplaceShop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subject String
  closed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages ShopperMessage[]

  @@index([shopperId, updatedAt])
  @@index([shopId, updatedAt])
}

model ShopperMessage {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  request ShopperRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromShop Boolean @default(false)
  text String
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

model ShopperAddress {
  id String @id @default(uuid()) @db.Uuid
  shopperId String
  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  label String
  details Json
  createdAt DateTime @default(now())

  @@index([shopperId, createdAt])
}

enum OrderCaseKind {
  RETURN
  DISPUTE
  CANCEL
  EXCHANGE
}

enum OrderCaseStatus {
  OPEN
  IN_REVIEW
  RETURN_APPROVED
  DECLINED
  RESOLVED
  WITHDRAWN
  RETURN_RECEIVED
  PICKUP_SCHEDULED
  REFUND_APPROVED
  EXCHANGE_SHIPPED
}

model OrderCase {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      OrderCaseKind
  status    OrderCaseStatus @default(OPEN)
  revision  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    OrderCaseEvent[]
  returnLines OrderCaseReturnLine[]
  returnReceivedAt DateTime?
  returnReceivedById String?
  returnReceivedBy User? @relation("ReturnCaseReceiver", fields: [returnReceivedById], references: [id], onDelete: SetNull)
  returnDisposition BangladeshReturnDisposition?
  pickupAt DateTime?
  pickupReference String? @db.VarChar(80)
  refundAmountMinor Int?
  replacementTrackingReference String? @db.VarChar(80)

  @@index([orderId, updatedAt])
  @@index([status, updatedAt])
}

enum BangladeshReturnDisposition {
  RESTOCK
  HOLD
}

model BangladeshRefusedParcelReceipt {
  orderId       String                     @id @db.Uuid
  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedAt    DateTime                   @default(now())
  receivedById  String?
  receivedBy    User?                      @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  disposition   BangladeshReturnDisposition
  restockedUnits Int
  note          String                     @db.VarChar(500)
}

model OrderCaseReturnLine {
  caseId      String    @db.Uuid
  orderCase   OrderCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  replacementVariantId String?
  replacementVariant   Variant? @relation("ExchangeReplacement", fields: [replacementVariantId], references: [id], onDelete: Restrict)
  replacementVariantName String?

  @@id([caseId, orderItemId])
  @@index([orderItemId])
  @@index([replacementVariantId])
}

model OrderCaseEvent {
  id        String          @id @default(uuid()) @db.Uuid
  caseId    String          @db.Uuid
  orderCase OrderCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status    OrderCaseStatus
  note      String?
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  revision  Int
  createdAt DateTime       @default(now())

  @@unique([caseId, revision])
}
