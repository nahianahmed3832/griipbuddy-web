  action              OperationalWorkflowAction
  status              OperationalWorkflowStatus @default(DRAFT)
  ownerId             String
  agentRole           String?                    @db.VarChar(24)
  requestKey          String                     @db.VarChar(120)
  inputFingerprint    String                     @db.Char(64)
  targetKey           String                     @db.VarChar(240)
  resourceKey         String                     @db.VarChar(260)
  resourceHeld        Boolean                    @default(false)
  policyVersion       String                     @db.VarChar(120)
  approvedBy          String?
  approvedPolicy      String?                    @db.VarChar(120)
  title               String                     @db.VarChar(220)
  expectedOutcome     String                     @db.VarChar(500)
  uncertainty         String                     @db.VarChar(500)
  evidence            Json
  payload             Json
  benefit             Int?
  confidence          Int?
  effort              Int?
  stock               Int?
  budgetMinor         Int?
  budgetCurrency      CurrencyCode?
