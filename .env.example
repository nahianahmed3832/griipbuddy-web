# Dedicated local PostgreSQL database. Replace the password placeholder.
DATABASE_URL=postgresql://griipbuddy_dev:replace-me@127.0.0.1:55432/griipbuddy_dev
COMMERCE_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3100
# Generate each secret independently with: openssl rand -hex 32
BETTER_AUTH_SECRET=
CHECKOUT_SECRET=
# Optional default market and validated JSON market overrides. See docs/markets.md.
GRIIP_DEFAULT_MARKET=
GRIIP_MARKET_CONFIGURATION=
# Enable the first-party event collector when ready to measure.
ACQUISITION_MEASUREMENT=0
# Homepage recommendation experiment. Only the isolated market review and local test databases can enroll.
GRIIP_RECOMMENDATION_EXPERIMENT=0
# Optional shared or market-specific public Microsoft Clarity project IDs.
CLARITY_PROJECT_ID=
# CLARITY_PROJECT_ID_BD=
# CLARITY_PROJECT_ID_US=
# See docs/markets.md for the validated JSON formats.
# GRIIP_MARKET_CONFIGURATION=
# GRIIP_REPORTING_FX=
# GRIIP_REPORTING_FX_TEST=
# PRODUCT_INTELLIGENCE_ANALYST_PROVIDER=openai
# PRODUCT_INTELLIGENCE_ANALYST_MODEL=
# PRODUCT_INTELLIGENCE_ANALYST_API_KEY=
# PRODUCT_INTELLIGENCE_ANALYST_MAX_CALLS_PER_24H=
